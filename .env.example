# ==============================================================================
# LAB-Ux — Variables de entorno (ejemplo)
# Copiar a .env.local y completar secretos antes de `docker compose up --build`
# ==============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_PORT=3000
NEXT_PUBLIC_API_URL=https://backend.lab-ux.site
# Si migrás a API Routes locales, usar:
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ── MariaDB (servicio `mariadb` en docker-compose.yml) ──────────────────────
MYSQL_DATABASE=labux
MYSQL_USER=labux
MYSQL_PASSWORD=labux_secret
MYSQL_ROOT_PASSWORD=labux_root_2026
MYSQL_PORT=3306
DATABASE_URL=mysql://labux:labux_secret@mariadb:3306/labux
# Para acceso local fuera de Docker (host):
# DATABASE_URL=mysql://labux:labux_secret@127.0.0.1:3306/labux

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
# Generar con: openssl rand -hex 32  (Linux/WSL) o node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Adminer / phpMyAdmin (profile tools) ────────────────────────────────────
ADMINER_PORT=8080

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ=America/Argentina/Catamarca

# ── Legacy — DEPRECATED ──────────────────────────────────────────────────────
# MONGODB_URI se mantiene por compatibilidad pero está deprecado.
# Todo el código nuevo debe usar DATABASE_URL + src/lib/db.ts (mysql2).
# No definir MONGODB_URI en instalaciones nuevas.
# MONGODB_URI=mongodb://db:27017/mi-db
# REACT_APP_API_URL es legacy CRA, ignorado por Next.js. Usar NEXT_PUBLIC_API_URL.
# REACT_APP_API_URL=https://backend.lab-ux.site
